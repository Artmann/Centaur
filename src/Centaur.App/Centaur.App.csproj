<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- AVLN3001: a window without a parameterless constructor cannot be built by
         Avalonia's runtime XAML loader. MainWindow is always constructed by App with its
         dependencies passed in; adding a parameterless constructor back would mean
         reaching into the static service provider from inside the window again. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Embedded in the exe's win32 resources, which is what Explorer, the taskbar and
         Alt+Tab read. Regenerate with tools/build-icon.ps1 after changing the artwork. -->
    <ApplicationIcon>Assets\centaur.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the window icon is embedded as a resource. Assets/centaur.png is the source
         artwork the other two are derived from and has no business in the binary. -->
    <AvaloniaResource Include="Assets\centaur-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centaur.Core\Centaur.Core.csproj" />
    <ProjectReference Include="..\Centaur.Rendering\Centaur.Rendering.csproj" />
    <ProjectReference Include="..\Centaur.Pty.Windows\Centaur.Pty.Windows.csproj" />
  </ItemGroup>
</Project>
